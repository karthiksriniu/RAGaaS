# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam (STT / LLM / TTS). This is the MODEL api key (sk_...),
# --- NOT the Conversations/Samvaad key (sk_samvaad_...).
SARVAM_API_KEY=

# --- MyBizCare retrieval ---
MYBIZCARE_BASE_URL=https://agriadvisor-poc-staging.vercel.app
# Must match VOICE_WORKER_TOKEN set on the MyBizCare deployment.
VOICE_WORKER_TOKEN=
# Which tenant this worker serves. Single-tenant for the A3 spike; see
# README for the dialed-number resolution that makes it multi-tenant.
MYBIZCARE_TENANT_ID=homegrown

# --- Warm transfer (Vobiz SIP trunk; REFER works on verified trunks) ---
EXPERT_PHONE_NUMBER=
SIP_TRUNK_HOSTNAME=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
