# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam (STT / LLM / TTS). This is the MODEL api key (sk_...),
# --- NOT the Conversations/Samvaad key (sk_samvaad_...).
SARVAM_API_KEY=

# --- MyBizCare retrieval ---
MYBIZCARE_BASE_URL=https://agriadvisor-poc-staging.vercel.app
# Must match VOICE_WORKER_TOKEN set on the MyBizCare deployment.
VOICE_WORKER_TOKEN=
# Tenant is resolved per call from the number the caller dialed, so ONE
# worker serves every tenant and there is nothing to set here.
# This is only for `agent.py console`, which has no SIP participant and so
# no dialed number. Leave EMPTY in production - it is the only thing that
# could make the worker answer as a tenant nobody dialed.
DEV_FALLBACK_TENANT_NUMBER=

# --- Warm transfer (Vobiz SIP trunk; REFER works on verified trunks) ---
EXPERT_PHONE_NUMBER=
SIP_TRUNK_HOSTNAME=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=
